<div class="vtm-roll vtm-combat-damage {{#if noDamage}}soaked{{else}}damage-dealt{{/if}}">
  <div class="roll-header dual-portrait">
    <div class="roll-portrait-wrap">
      <img class="roll-portrait" src="{{attackerImg}}" style="{{attackerPortraitStyle}}" />
    </div>
    <div class="roll-info">
      <span class="roll-actor">{{weaponName}}: урон</span>
      <span class="roll-label">{{attackerName}} → {{defenderName}}</span>
    </div>
    <div class="roll-portrait-wrap">
      <img class="roll-portrait" src="{{defenderImg}}" style="{{defenderPortraitStyle}}" />
    </div>
  </div>

  <div class="combat-damage-section">
    <div class="damage-row">
      <span class="damage-header"><i class="fas fa-crosshairs"></i> Урон ({{dmgLabel}}), пул {{dmgPool}}{{#if dmgDifficulty}}, сложность {{dmgDifficulty}}{{/if}}</span>
      <div class="roll-dice">
        {{#each dmgDice}}
        <span class="die {{this.status}}">{{this.value}}</span>
        {{/each}}
      </div>
      <span class="damage-subtotal">{{#if dmgAutoSuccesses}}{{dmgDiceTotal}} + {{dmgAutoSuccesses}} Могущества = {{/if}}Урон: {{dmgSuccesses}}</span>
    </div>

    <div class="damage-row">
      {{#if soakSkipped}}
      <span class="damage-header"><i class="fas fa-shield-alt"></i> Поглощение ({{soakLabel}})</span>
      <span class="damage-subtotal">Без броска поглощения</span>
      {{else}}
      <span class="damage-header"><i class="fas fa-shield-alt"></i> Поглощение ({{soakLabel}}), пул {{soakPool}}{{#if soakDifficulty}}, сложность {{soakDifficulty}}{{/if}}</span>
      <div class="roll-dice">
        {{#each soakDice}}
        <span class="die {{this.status}}">{{this.value}}</span>
        {{/each}}
      </div>
      <span class="damage-subtotal">Поглощено: {{soakSuccesses}}</span>
      {{/if}}
    </div>
  </div>

  {{#if detailedReport}}
  <section class="vtm-chronicle-report" aria-label="Подробности нанесения урона">
    <div class="vtm-report-title"><i class="fas fa-scroll"></i> Ход расчета</div>
    {{#each detailedReport.steps}}
    <div class="vtm-report-step"><strong>{{this.label}}:</strong> <span>{{this.text}}</span></div>
    {{/each}}
    <div class="vtm-report-final {{detailedReport.finalClass}}">{{detailedReport.final}}</div>
  </section>
  {{/if}}

  <div class="combat-summary">
    {{#if damageAdjustment}}
    <div class="combat-defended"><i class="fas fa-moon"></i> {{damageAdjustment}}</div>
    {{/if}}
    {{#if dazedNotice}}
    <div class="combat-defended"><i class="fas fa-star"></i> {{dazedNotice}}</div>
    {{/if}}
    {{#if quillsNotice}}
    <div class="combat-hit"><i class="fas fa-bone"></i> {{quillsNotice}}</div>
    {{/if}}
    {{#if armorDestroyedNotice}}
    <div class="combat-hit"><i class="fas fa-shield-alt"></i> {{armorDestroyedNotice}}</div>
    {{/if}}
    {{#if firearmNote}}
    <div class="combat-hit"><i class="fas fa-crosshairs"></i> {{firearmNote}}</div>
    {{/if}}
    {{#if disarmMode}}
    {{#if disarmSuccess}}
    <div class="combat-hit"><i class="fas fa-hand-scissors"></i> {{defenderName}} обезоружен! ({{dmgSuccesses}} успехов против Силы {{disarmStr}})</div>
    {{else}}
    <div class="combat-defended"><i class="fas fa-shield-alt"></i> Удар не выбил оружие ({{dmgSuccesses}} успехов против Силы {{disarmStr}}). Урон не нанесен.</div>
    {{/if}}
    {{else}}
    {{#if kissMode}}
    {{#if kissPenetrated}}
    <div class="combat-hit"><i class="fas fa-tint"></i> Укус удался! Поцелуй действует на {{defenderName}}.</div>
    {{#if kissCanResist}}
    <div class="combat-actions">
      <button type="button" class="kiss-resist-btn"><i class="fas fa-fist-raised"></i> Сопротивляться Поцелую</button>
    </div>
    {{else}}
    <div class="combat-defended"><i class="fas fa-heart"></i> Смертные не могут сопротивляться Поцелую.</div>
    {{/if}}
    {{else}}
    <div class="combat-defended"><i class="fas fa-shield-alt"></i> Укус не пробил защиту.</div>
    {{/if}}
    {{else}}
    {{#if noDamage}}
    <div class="combat-defended"><i class="fas fa-shield-alt"></i> {{#if damageAdjustment}}Урон не нанесен.{{else}}Весь урон поглощен!{{/if}}</div>
    {{else}}
    <div class="combat-hit">{{defenderName}}: урон {{netDamage}} ({{damageType}})</div>
    {{/if}}
    {{/if}}
    {{/if}}
    <div class="combat-condition">
      {{defenderName}}: <span class="condition-label">{{condition}}</span>
      {{#if penalty}} <span class="condition-penalty">({{penalty}})</span>{{/if}}
    </div>
  </div>
</div>
