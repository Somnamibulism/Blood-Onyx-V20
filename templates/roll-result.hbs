<div class="vtm-roll {{outcome}}">
  <div class="roll-header">
    <div class="roll-portrait-wrap">
      <img class="roll-portrait" src="{{actorImg}}" style="{{portraitStyle}}" />
    </div>
    <div class="roll-info">
      <span class="roll-actor">{{actorName}}</span>
      <span class="roll-label">{{label}}</span>
    </div>
  </div>
  <div class="roll-meta">
    Пул {{pool}}{{#if poolNote}} ({{poolNote}}){{/if}} | Сложность {{difficulty}}{{#if specialty}} | Специализация{{/if}}
  </div>
  <div class="roll-dice">
    {{#each dice}}
    <span class="die {{this.status}}">{{this.value}}</span>
    {{/each}}
  </div>
  <div class="roll-result">
    {{#if (eq outcome "botch")}}<span class="result-botch">ПРОВАЛ!</span>{{/if}}
    {{#if (eq outcome "failure")}}<span class="result-fail">Неудача</span>{{/if}}
    {{#if (eq outcome "success")}}
      <span class="result-success">
        {{#if autoSuccesses}}{{diceTotal}} + {{autoLabel}} = {{/if}}Успехов: {{total}}
      </span>
    {{/if}}
  </div>
  {{#if powerMeta}}
  <div class="vtm-power-audit">
    <div><b>Проверка дисциплины V20</b> · {{powerMeta.caster}} → {{powerMeta.target}}</div>
    <div>Основание сложности: {{powerMeta.basis}}</div>
    <div>Успехов на кубах до единиц: {{powerMeta.successesBeforeOnes}} · Единиц: {{powerMeta.ones}} · Итог: <b>{{powerMeta.net}}</b></div>
    {{#if powerMeta.note}}<div>{{powerMeta.note}}</div>{{/if}}
  </div>
  {{/if}}
  {{#if extra}}
  <div class="roll-extra">{{extra}}</div>
  {{/if}}
  {{#if ledgeBtn}}
  <button type="button" class="jump-ledge-btn"><i class="fas fa-hand-rock"></i> Ухватиться за край (Ловкость + Атлетика)</button>
  {{/if}}
</div>
